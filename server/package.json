{
    "name": "Higher Waist-ecommerce-server",
    "version": "1.0.0",
    "description": "Higher Waist E-commerce Backend API",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "migrate": "node migrations/migrate.js",
        "migrate:uuid": "node scripts/migrate_to_uuid.js",
        "images:optimize:products": "node scripts/optimize_product_images.js",
        "images:optimize:all": "node scripts/optimize_all_images.js",
        "images:optimize:all:apply": "node scripts/optimize_all_images.js --apply",
        "test:prod:smoke": "node --test tests/prod-smoke.test.mjs",
        "test:prod:ui": "playwright test tests/prod-ui.spec.mjs",
        "test:prod:all": "npm run test:prod:smoke && npm run test:prod:ui"
    },
    "keywords": [
        "ecommerce",
        "api",
        "express"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "body-parser": "^1.20.2",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "node-fetch": "^3.3.2",
        "nodemailer": "^8.0.1",
        "pg": "^8.11.5",
        "sharp": "^0.34.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "nodemon": "^3.0.2"
    },
    "overrides": {
        "qs": "^6.15.0"
    }
}